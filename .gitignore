# MiniExam material is private, except the archived past-semester papers, which
# are published as student practice. Exclude the directory contents rather than
# the directory itself, so the _archive/ carve-out can re-include.
/Parts/**/*MiniExam*/*
!/Parts/**/*MiniExam*/_archive/
/Parts/**/*MiniExam*.*
/syllabi/24F/
/simulations/24F/
/simulations/*pre24F*
*.gsheet

# Generated Manim/Jupyter/Python output is development-only, except the built
# presentation viewers, which are published to students. Exclude media/ contents
# rather than media/ itself, since git cannot re-include from an excluded directory.
/Parts/**/media/*
!/Parts/**/media/*_present/
/Parts/**/media_A4/
__pycache__/
*.py[cod]

# Credentials and student records must never be committed here.
.env
.env.*
!.env.example
*.pem
*.key
