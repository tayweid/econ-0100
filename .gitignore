# Everything committed to this repository is published.
#
# Material that should not be published belongs in ECON_0100 -- not behind an
# ignore rule here. This file only excludes machine noise, regenerable build
# output, and credentials.

# Machine noise
.DS_Store
Icon
.claude/

# Regenerable render and build output
**/*_checkpoints/
.ipynb_checkpoints/
__pycache__/
*.py[cod]

# Credentials
.env
.env.*
!.env.example
*.pem
*.key
