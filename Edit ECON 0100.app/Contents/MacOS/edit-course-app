#!/bin/bash
# Edit <course>.app: opens the course folder it sits in (the one holding
# course-content.yaml.js) in the form editor. It starts edit-course from the sibling
# checkout, ../tayweid.github.io/course-assets/editor/, in the background; the editor opens
# in the default browser and stops itself a few minutes after its last tab closes.
# Launching again while it runs just opens another tab. A new course gets its own app by
# copying this one into its folder and renaming it.

site="$(cd "$(dirname "$0")/../../.." && pwd)"
script="$site/../tayweid.github.io/course-assets/editor/edit-course"
if [ ! -f "$site/course-content.yaml.js" ]; then
    osascript -e 'display alert "Edit Course has no course here" message "Put this app in a course folder, the one holding course-content.yaml.js, and open it from there (or drag it to the Dock from there)."'
    exit 1
fi
if [ ! -f "$script" ]; then
    osascript -e 'display alert "Edit Course cannot find the editor" message "It looks for tayweid.github.io/course-assets/editor/edit-course beside this course folder."'
    exit 1
fi

# Apps opened from Finder get a bare PATH, so look for Python where it usually lives.
for python in /opt/homebrew/bin/python3 /usr/local/bin/python3 /opt/anaconda3/bin/python3 "$HOME/anaconda3/bin/python3" /usr/bin/python3; do
    [ -x "$python" ] && break
done

nohup "$python" "$script" "$site" >> "$HOME/Library/Logs/Edit Course.log" 2>&1 &
