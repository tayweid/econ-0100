#!/usr/bin/env ruby

require 'cgi'
require 'pathname'
require 'set'
require 'yaml'

ROOT = Pathname.new(__dir__).parent.expand_path
CONTENT_PATH = ROOT.join('course-content.yml')
CHECK_ONLY = ARGV.include?('--check')

COURSE = {
  'code' => 'ECON 0100',
  'brand' => ['MICRO', 'ECON'],
  'syllabus' => 'Syllabus.pdf',
  'stylesheet' => 'https://tayweid.github.io/course-assets/course.css',
  'script' => 'https://tayweid.github.io/course-assets/course.js',
  'reading_video' => 'uwYCeUVcx4E'
}.freeze

KNOWN_MISSING = %w[
  Vignettes/Vignette_D3.pdf
  Vignettes/Vignette_D3_sols.pdf
  Vignettes/Vignette_D4.pdf
  Vignettes/Vignette_D4_sols.pdf
  Homework/HW_E2_sols.pdf
  Homework/HW_F_sols.pdf
].to_set.freeze

def escape(value)
  CGI.escapeHTML(value.to_s)
end

def inline_text(value)
  escape(value).gsub(/\*([^*]+)\*/, '<i>\1</i>')
end

def youtube_thumbnail(video)
  "https://img.youtube.com/vi/#{video}/maxresdefault.jpg"
end

def link(label, href)
  icon, css = if label == 'Practice'
                ['fa fa-pencil', 'practice-link']
              elsif href.start_with?('http')
                ['fa fa-external-link', 'download-link']
              else
                ['fa fa-file-pdf-o', 'download-link']
              end
  %(<a href="#{escape(href)}" class="#{css}" target="_blank" rel="noopener"><i class="#{icon}" aria-hidden="true"></i> #{escape(label)}</a>)
end

def title_links(items)
  Array(items).map { |item| link(item.fetch('label'), item.fetch('file')) }
end

def reading_file(chapter)
  candidates = [
    "Reading/Ch_#{chapter.to_s.rjust(2, '0')}.pdf",
    "Reading/Ch_#{chapter}.pdf"
  ].uniq
  candidates.find { |candidate| ROOT.join(candidate).exist? } || candidates.last
end

def file_pair(folder, prefix, base, options = {})
  links = []
  if options.fetch('file', true)
    file_base = options['file'].is_a?(String) ? options['file'] : base
    links << { 'label' => options.fetch('file_label', prefix), 'file' => "#{folder}/#{prefix}_#{file_base}.pdf" }
  end
  if options.fetch('solutions', true)
    solution_base = options['solution_file'] || (options['file'].is_a?(String) ? options['file'] : base)
    links << { 'label' => 'Solutions', 'file' => "#{folder}/#{prefix}_#{solution_base}_sols.pdf" }
  end
  links
end

# Links whichever of Vignettes/Vignette_<base>.pdf and its _sols exist on disk;
# `files:` overrides the base name, `files: false` suppresses, `solutions: false` drops the key.
def vignette_links(config, default_base)
  return [] if config['files'] == false

  base = config['files'].is_a?(String) ? config['files'] : default_base
  items = []
  file = "Vignettes/Vignette_#{base}.pdf"
  items << { 'label' => 'Vignette', 'file' => file } if ROOT.join(file).exist?
  if config.fetch('solutions', true)
    solution_file = config['solution_file'] || "Vignettes/Vignette_#{base}_sols.pdf"
    items << { 'label' => 'Solutions', 'file' => solution_file } if ROOT.join(solution_file).exist?
  end
  items
end

def homework_config(part, block)
  defaults = part.fetch('homework_defaults', {})
  overrides = block.fetch('homework', {}) || {}
  defaults.merge(overrides)
end

def standard_card(kind, name:, description:, video: nil, topic: nil, links: [], empty: false, standalone: false, play_icon: '▶')
  type = case kind
         when 'homework' then 'homework'
         when 'vignette', 'demo' then 'exercise'
         else 'concept'
         end
  classes = ["#{type}-card"]
  classes << 'placeholder' if empty
  classes << (standalone == :plain ? 'standalone' : 'standalone-card') if standalone

  {
    'type' => type,
    'classes' => classes,
    'name' => name,
    'topic' => topic,
    'description' => description,
    'video' => video,
    'links' => links,
    'empty' => empty,
    'play_icon' => play_icon
  }
end

def generic_card(resource, standalone: false)
  kind = resource.fetch('kind')
  links = Array(resource['links'])
  if kind == 'demo'
    base = resource['files'] || resource.fetch('name').sub(/^Demo\s+/, '')
    links += file_pair('Demos', 'Demo', base, {
      'file' => resource.fetch('file', true),
      'solutions' => resource.fetch('solutions', true),
      'solution_file' => resource['solution_file'],
      'file_label' => 'Demo'
    })
  elsif kind == 'vignette'
    links += vignette_links(resource, resource.fetch('name').sub(/^Vignette\s+/, ''))
  end

  standard_card(
    kind,
    name: resource.fetch('name'),
    description: inline_text(resource.fetch('description', '')),
    video: resource['video'],
    links: links,
    empty: resource.fetch('empty', false),
    standalone: standalone
  )
end

def block_cards(part, block)
  block_id = block.fetch('block')
  episode = block.fetch('episode')
  reading = block.fetch('reading')
  vignette = block.fetch('vignette')
  homework = homework_config(part, block)

  episode_links = Array(episode['links'])
  cards = [standard_card(
    'episode',
    name: episode.fetch('name', "Episode #{block_id}"),
    description: inline_text(episode.fetch('description')),
    video: episode['video'],
    links: episode_links,
    empty: episode.fetch('empty', false)
  )]

  reading_name = if reading['chapter']
                   "Chapter #{reading['chapter']}:"
                 else
                   reading.fetch('name')
                 end
  reading_links = []
  if reading['chapter'] && reading.fetch('file', true)
    reading_links << { 'label' => 'Reading', 'file' => reading['file'].is_a?(String) ? reading['file'] : reading_file(reading['chapter']) }
  end
  reading_links += Array(reading['links'])
  reading_video = if reading.key?('video')
                    reading['video']
                  elsif reading['chapter']
                    COURSE['reading_video']
                  end
  cards << standard_card(
    'reading',
    name: reading_name,
    topic: reading['topic'],
    description: inline_text(reading.fetch('description', '*Skim the text to understand the main ideas*')),
    video: reading_video,
    links: reading_links,
    empty: reading.fetch('empty', false),
    play_icon: block_id.start_with?('A') ? '▶' : '🎧'
  )

  cards << standard_card(
    'vignette',
    name: vignette.fetch('name', "Vignette #{block_id}"),
    description: inline_text(vignette.fetch('description')),
    video: vignette['video'],
    links: vignette_links(vignette, block_id),
    empty: vignette.fetch('empty', false)
  )

  practice = homework.fetch('practice', "hw#{block_id.downcase}")
  homework_links = practice ? [{ 'label' => 'Practice', 'file' => "Practice/#{practice}.html" }] : []
  if homework['file']
    homework_links << { 'label' => 'Assignment', 'file' => "Homework/HW_#{homework['file']}.pdf" }
  end
  if homework['solutions']
    solution_base = homework['solution_file'] || homework['file']
    homework_links << { 'label' => 'Solutions', 'file' => "Homework/HW_#{solution_base}_sols.pdf" }
  end
  homework_name = "Homework #{block_id}#{homework['due'] ? ':' : ''}"
  cards << standard_card(
    'homework',
    name: homework_name,
    topic: homework['due'],
    description: 'Unlimited practice. Instant feedback. Submit to <a href="https://gradescope.com" target="_blank" rel="noopener">Gradescope</a>.',
    links: homework_links
  )

  cards + Array(block['extras']).map { |resource| generic_card(resource) }
end

def render_card(card, indent = '                ')
  classes = ['carousel-card', *card.fetch('classes')].join(' ')
  video_attribute = card['video'] ? %( data-video-id="#{escape(card['video'])}") : ''
  image = if card['empty']
            ''
          elsif card['video']
            %(<img src="#{youtube_thumbnail(card['video'])}" alt="#{escape(card['name'])} thumbnail">\n#{indent}        <div class="play-button">#{card['play_icon']}</div>)
          else
            %(<img alt="" class="placeholder-bg">)
          end
  topic = card['topic'] ? %( <span class="chapter-topic">#{escape(card['topic'])}</span>) : ''
  links = card.fetch('links').empty? ? '' : " #{title_links(card['links']).join(' ')}"

  html = <<~HTML.chomp
    <div class="#{classes}"#{video_attribute}>
        <div class="card-video">
            #{image}
        </div>
        <div class="card-content">
            <h3 class="card-title">#{escape(card['name'])}#{topic}#{links}</h3>
            <p class="card-description">#{card['description']}</p>
        </div>
    </div>
  HTML
  html.lines.map { |line| line.strip.empty? ? '' : "#{indent}#{line.rstrip}" }.join("\n")
end

def render_carousel(id:, title:, description:, cards:)
  description_html = description.to_s.empty? ? '' : %(
        <p class="block-description">#{description}</p>)
  rendered_cards = cards.map { |card| render_card(card) }.join("\n\n")
  <<~HTML.chomp
        <div class="carousel-container" id="#{escape(id)}">
            <h1 class="subtitle">#{escape(title)}</h1>#{description_html}
            <div class="carousel">
                <button class="carousel-arrow carousel-arrow-left" aria-label="Previous resource" type="button">
                    <span aria-hidden="true">‹</span>
                </button>
                <div class="carousel-track">
    #{rendered_cards}
                </div>
                <button class="carousel-arrow carousel-arrow-right" aria-label="Next resource" type="button">
                    <span aria-hidden="true">›</span>
                </button>
                <div class="carousel-indicator"></div>
            </div>
        </div>
  HTML
end

# ---------------------------------------------------------------------------
# Block = episode (+ reading) on the left, the three practice steps on the
# right: exercise in class, vignette in recitation, homework at home.
# Optional per-block `dates:` (ISO yyyy-mm-dd) let course.js mark the current step.
# ---------------------------------------------------------------------------

# 2026-09-04 -> "Fri Sep 4"
def short_date(iso)
  require 'date'
  Date.parse(iso.to_s).strftime('%a %b %-d')
rescue ArgumentError
  iso.to_s
end

def path_links(items, indent)
  return '' if items.empty?

  %(\n#{indent}<div class="path-links">#{title_links(items).join(' ')}</div>)
end

def path_thumb(video, indent)
  return '' unless video

  %(\n#{indent}    <a class="path-thumb" href="https://www.youtube.com/watch?v=#{escape(video)}" target="_blank" rel="noopener"><img src="#{youtube_thumbnail(video)}" alt=""></a>)
end

def path_step(name, where, links, date, indent, due: nil, video: nil)
  date_attribute = date ? %( data-date="#{escape(date)}") : ''
  due_html = due ? %(\n#{indent}        <p class="path-due">Due #{escape(due)}</p>) : ''
  links_html = links.empty? ? '' : %(\n#{indent}        <div class="path-links">#{title_links(links).join(' ')}</div>)
  <<~HTML.chomp
    #{indent}<li class="path-step"#{date_attribute}>
    #{indent}    <span class="path-dot" aria-hidden="true"></span>
    #{indent}    <div>
    #{indent}        <p class="path-name">#{escape(name)} <span class="path-where">#{escape(where)}</span></p>#{links_html}#{due_html}
    #{indent}    </div>#{path_thumb(video, indent)}
    #{indent}</li>
  HTML
end

# Optional material hangs off the end of a block's path: dashed dot, quieter text,
# and a small thumbnail on the right when it is a video.
def extra_step(extra, indent)
  video = extra['video']
  links = Array(extra['links'])
  if extra['files']   # a demo: Demos/Demo_<files>.pdf and its solutions, when they exist
    ["Demos/Demo_#{extra['files']}.pdf", "Demos/Demo_#{extra['files']}_sols.pdf"].zip(%w[Demo Solutions]).each do |file, label|
      links << { 'label' => label, 'file' => file } if ROOT.join(file).exist?
    end
  end
  video_attribute = video ? %( data-video-id="#{escape(video)}") : ''
  thumb = path_thumb(video, indent)
  <<~HTML.chomp
    #{indent}<li class="path-step path-step-alt path-step-extra"#{video_attribute}>
    #{indent}    <span class="path-dot path-dot-alt" aria-hidden="true"></span>
    #{indent}    <div>
    #{indent}        <p class="path-name">#{escape(extra.fetch('name'))} <span class="path-where">optional</span></p>#{path_links(links, indent + '        ')}
    #{indent}    </div>#{thumb}
    #{indent}</li>
  HTML
end

def render_block(part, block)
  block_id = block.fetch('block')
  episode = block.fetch('episode')
  reading = block.fetch('reading')
  vignette = block.fetch('vignette')
  homework = homework_config(part, block)
  dates = block.fetch('dates', {}) || {}
  indent = '        '

  # episode + reading
  episode_name = episode.fetch('name', "Episode #{block_id}")
  video = episode['video']
  video_attribute = video ? %( data-video-id="#{escape(video)}") : ''
  image = if video
            %(<img src="#{youtube_thumbnail(video)}" alt="#{escape(episode_name)} thumbnail">\n#{indent}            <div class="play-button">▶</div>)
          else
            %(<img alt="" class="placeholder-bg">)
          end
  episode_links = Array(episode['links'])
  if reading['chapter'] && reading.fetch('file', true)
    file = reading['file'].is_a?(String) ? reading['file'] : reading_file(reading['chapter'])
    episode_links << { 'label' => "Chapter #{reading['chapter']}", 'file' => file }
  elsif reading['name']
    episode_links += Array(reading['links'])
  end

  # steps
  exercise = block.fetch('exercise', {}) || {}
  homework_links = []
  homework_links << { 'label' => 'Homework', 'file' => "Homework/HW_#{homework['file']}.pdf" } if homework['file']
  if homework['solutions']
    solution_base = homework['solution_file'] || homework['file']
    homework_links << { 'label' => 'Solutions', 'file' => "Homework/HW_#{solution_base}_sols.pdf" }
  end
  due = dates['homework'] ? short_date(dates['homework']) : homework['due']

  steps = [
    path_step(exercise.fetch('name', "Exercise #{block_id}"), 'in class', Array(exercise['links']), dates['class'], indent + '            ', video: exercise['video']),
    path_step(vignette.fetch('name', "Vignette #{block_id}"), 'recitation', vignette_links(vignette, block_id), dates['recitation'], indent + '            ', video: vignette['video']),
    path_step("Homework #{block_id}", 'home', homework_links, dates['homework'], indent + '            ', due: due, video: homework['video'])
  ]
  steps = (Array(block['extras']).map { |extra| extra_step(extra, indent + '            ') } + steps).join("\n")

  <<~HTML.chomp
    #{indent}<div class="block" id="part-#{block_id.downcase}">
    #{indent}    <h1 class="subtitle">Block #{escape(block_id)} | #{escape(block.fetch('title'))}</h1>
    #{indent}    <p class="block-description">#{escape(block.fetch('description'))}</p>
    #{indent}    <div class="path">
    #{indent}        <div class="path-episode"#{video_attribute}>
    #{indent}            <div class="card-video">
    #{indent}                #{image}
    #{indent}            </div>
    #{indent}            <p class="path-name">#{escape(episode_name)} <span class="path-desc">#{inline_text(episode.fetch('description')).gsub(%r{</?i>}, '')}</span></p>#{path_links(episode_links, indent + '            ')}
    #{indent}        </div>
    #{indent}        <ol class="path-steps">
    #{steps}
    #{indent}        </ol>
    #{indent}    </div>
    #{indent}</div>
  HTML
end

def render_checkpoint(part_id, config)
  demo = config.fetch('demo')
  indent = '        '
  video = demo['video']
  video_attribute = video ? %( data-video-id="#{escape(video)}") : ''
  image = if video
            %(<img src="#{youtube_thumbnail(video)}" alt="Demo #{escape(part_id)} thumbnail">\n#{indent}            <div class="play-button">▶</div>)
          else
            %(<img alt="" class="placeholder-bg">)
          end
  base = demo.fetch('file', part_id)
  demo_links = []
  ["Demos/Demo_#{base}.pdf", "Demos/Demo_#{base}_sols.pdf"].zip(%w[Demo Solutions]).each do |file, label|
    demo_links << { 'label' => label, 'file' => file } if ROOT.join(file).exist?
  end
  walkthrough = demo.fetch('description', "Attempt Demo #{part_id} first, then walk through with me.")
  when_line = config['when'] || (config['date'] ? short_date(config['date']) : nil)
  when_html = when_line ? %(\n#{indent}                    <p class="path-due">#{escape(when_line)}</p>) : ''
  date_attribute = config['date'] ? %( data-date="#{escape(config['date'])}") : ''

  <<~HTML.chomp
    #{indent}<div class="block checkpoint" id="checkpoint">
    #{indent}    <h1 class="subtitle">Checkpoint #{escape(part_id)}</h1>
    #{indent}    <p class="block-description">#{inline_text(config.fetch('description'))}</p>
    #{indent}    <div class="path">
    #{indent}        <div class="path-episode"#{video_attribute}>
    #{indent}            <div class="card-video">
    #{indent}                #{image}
    #{indent}            </div>
    #{indent}            <p class="path-name">Demo #{escape(part_id)} Walkthrough <span class="path-desc">#{inline_text(walkthrough).gsub(%r{</?i>}, '')}</span></p>
    #{indent}        </div>
    #{indent}        <ol class="path-steps path-checkpoint">
    #{path_step("Demo #{part_id}", 'home', demo_links, nil, indent + '            ')}
    #{indent}            <li class="path-step path-step-checkpoint"#{date_attribute}>
    #{indent}                <span class="path-dot path-dot-big" aria-hidden="true"></span>
    #{indent}                <div>
    #{indent}                    <p class="path-name">Checkpoint #{escape(part_id)} <span class="path-where">in class</span></p>#{when_html}
    #{indent}                </div>
    #{indent}            </li>
    #{indent}            <li class="path-step path-step-alt">
    #{indent}                <span class="path-dot path-dot-alt" aria-hidden="true"></span>
    #{indent}                <div>
    #{indent}                    <p class="path-name">Reattempt <span class="path-where">#{escape(config.fetch('reattempt', 'TBA'))}</span></p>
    #{indent}                </div>
    #{indent}            </li>
    #{indent}        </ol>
    #{indent}    </div>
    #{indent}</div>
  HTML
end

def render_homework_notes(config)
  questions = Array(config.fetch('questions')).map { |question| "                    <li>#{escape(question)}</li>" }.join("\n")
  file = "Homework/HW_#{config.fetch('file')}.pdf"
  <<~HTML.chomp
        <div id="#{escape(config.fetch('id', 'homework-details'))}">
            <h1 class="subtitle">#{escape(config.fetch('title'))}</h1>
            <p>#{escape(config.fetch('name'))} is due on Gradescope on <i>#{escape(config.fetch('due'))}</i>.</p>

            <div class="carousel-card homework-card standalone">
                <div class="card-video" style="padding-bottom: 30%; background: var(--main-md-color);">
                    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: white; text-align: center;">
                        <h3>Homework FAQs</h3>
                    </div>
                </div>
                <div class="card-content">
                    <h3 class="card-title">#{escape(config.fetch('name'))} #{link('Assignment', file)}</h3>
                    <div class="card-description">
                        <p><strong>Some FAQs:</strong></p>
                        <ol style="margin: 10px 0; padding-left: 20px;">
    #{questions}
                        </ol>
                    </div>
                </div>
            </div>
        </div>
  HTML
end

def section_id_and_nav(part_id, section)
  if section['block']
    ["part-#{section['block'].downcase}", "#{section['block']} | #{section.fetch('nav')}"]
  elsif section['carousel']
    config = section['carousel']
    [config.fetch('id'), config.fetch('nav', config.fetch('title'))]
  elsif section['checkpoint']
    ['checkpoint', 'Checkpoint']
  elsif section['homework_notes']
    config = section['homework_notes']
    [config.fetch('id', 'homework-details'), config.fetch('nav', config.fetch('title'))]
  elsif section['standalone']
    config = section['standalone']
    [config.fetch('id'), config.fetch('nav', config.fetch('title'))]
  else
    raise "Part #{part_id}: unknown section type"
  end
end

def render_section(part_id, part, section)
  if section['block']
    render_block(part, section)
  elsif section['carousel']
    config = section['carousel']
    render_carousel(
      id: config.fetch('id'),
      title: config.fetch('title'),
      description: inline_text(config.fetch('description', '')),
      cards: Array(config.fetch('resources')).map { |resource| generic_card(resource) }
    )
  elsif section['checkpoint']
    render_checkpoint(part_id, section['checkpoint'])
  elsif section['homework_notes']
    render_homework_notes(section['homework_notes'])
  elsif section['standalone']
    config = section['standalone']
    card = generic_card(config.fetch('resource'), standalone: :plain)
    <<~HTML.chomp
          <div id="#{escape(config.fetch('id'))}">
              <h1 class="subtitle">#{escape(config.fetch('title'))}</h1>
              <p>#{inline_text(config.fetch('description'))}</p>

      #{render_card(card, '        ')}
          </div>
    HTML
  end
end

def render_left_navigation(part_ids, active_part)
  parts = part_ids.map do |part_id|
    active = part_id == active_part ? ' class="active" aria-current="page"' : ''
    %(            <li><a#{active} href="part-#{part_id.downcase}.html">Part #{escape(part_id)}</a></li>)
  end.join("\n")
  brand = COURSE['brand'].map { |line| "            <span>#{escape(line)}</span>" }.join("\n")
  <<~HTML.chomp
    <div class="left_div">
        <nav aria-label="Course">
            <ul>
    #{brand}
                <hr class="nav-hr">
                <li class="nav-item-no-margin"><a class="btn" href="#{COURSE['syllabus']}" target="_blank" rel="noopener">Syllabus</a></li>
                <hr class="nav-hr-top">
    #{parts}
            </ul>
        </nav>
    </div>
  HTML
end

def render_right_navigation(part_id, sections)
  links = sections.each_with_index.map do |section, index|
    id, label = section_id_and_nav(part_id, section)
    li_class = index.zero? ? ' class="nav-item-no-margin"' : ''
    active = index.zero? ? ' active' : ''
    %(            <li#{li_class}><a href="##{escape(id)}" class="nav-link-right#{active}">#{escape(label)}</a></li>)
  end.join("\n")
  <<~HTML.chomp
    <div class="right_div">
        <nav aria-label="On this page">
            <ul>
                <span>Contents</span>
                <hr class="nav-hr-right">
    #{links}
            </ul>
        </nav>
    </div>
  HTML
end

def render_part(part_id, part, part_ids)
  sections = part.fetch('sections')
  rendered_sections = sections.map { |section| render_section(part_id, part, section) }.join("\n\n")
  <<~HTML
    <!doctype html>
    <!-- Generated from course-content.yml by scripts/build-course. Do not edit this file directly. -->
    <html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>#{COURSE['code']} | Part #{escape(part_id)}</title>
        <link rel="stylesheet" href="#{COURSE['stylesheet']}">
    </head>
    <body>
    <div class="wrapper course-econ-0100">
    #{render_left_navigation(part_ids, part_id)}

    <main class="content">
        <div class="description">
            <h1 class="title title-tight">Part #{escape(part_id)} | #{escape(part.fetch('title'))}</h1>
            <i class="subtitle-text">#{escape(part.fetch('tagline').sub(/\A./, &:upcase))}</i>
            <hr class="title-rule">
            <p>#{escape(part.fetch('introduction'))}</p>
        </div>

    #{rendered_sections}

        <div class="bottom-spacer"></div>
    </main>

    #{render_right_navigation(part_id, sections)}
    </div>
    <script src="#{COURSE['script']}"></script>
    </body>
    </html>
  HTML
end

def render_index(first_part)
  file = "part-#{first_part.downcase}.html"
  <<~HTML
    <!doctype html>
    <!-- Generated from course-content.yml by scripts/build-course. Do not edit this file directly. -->
    <html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta http-equiv="refresh" content="0; url=#{file}">
        <link rel="canonical" href="#{file}">
        <title>#{COURSE['code']} | Microeconomics</title>
    </head>
    <body>
        <p><a href="#{file}">Continue to #{COURSE['code']}</a></p>
    </body>
    </html>
  HTML
end

def check_keys(value, allowed, path, errors)
  unless value.is_a?(Hash)
    errors << "#{path} must be a mapping"
    return
  end
  (value.keys - allowed).each { |key| errors << "#{path}: unknown field #{key}" }
end

def require_keys(value, required, path, errors)
  return unless value.is_a?(Hash)

  required.each { |key| errors << "#{path}: missing required field #{key}" unless value.key?(key) }
end

def check_links(value, path, errors)
  Array(value).each_with_index do |item, index|
    check_keys(item, %w[label file], "#{path}[#{index}]", errors)
    require_keys(item, %w[label file], "#{path}[#{index}]", errors)
  end
end

def check_resource(resource, path, errors)
  check_keys(resource, %w[kind name video description links files file solutions solution_file empty], path, errors)
  return unless resource.is_a?(Hash)

  require_keys(resource, %w[kind name description], path, errors)
  check_links(resource['links'], "#{path}.links", errors)
end

def validate_schema(parts)
  errors = []
  unless parts.is_a?(Hash)
    return ['parts must be a mapping']
  end

  parts.each do |part_id, part|
    path = "parts.#{part_id}"
    check_keys(part, %w[title tagline introduction homework_defaults sections], path, errors)
    require_keys(part, %w[title tagline introduction sections], path, errors)
    next unless part.is_a?(Hash)

    check_keys(part['homework_defaults'], %w[due file solutions solution_file practice], "#{path}.homework_defaults", errors) if part['homework_defaults']
    unless part['sections'].is_a?(Array)
      errors << "#{path}.sections must be a list"
      next
    end

    part['sections'].each_with_index do |section, index|
      section_path = "#{path}.sections[#{index}]"
      unless section.is_a?(Hash)
        errors << "#{section_path} must be a mapping"
        next
      end

      if section['block']
        check_keys(section, %w[block nav title description episode reading vignette homework extras exercise dates], section_path, errors)
        check_keys(section['exercise'], %w[name links video], "#{section_path}.exercise", errors) if section['exercise']
        check_keys(section['dates'], %w[class recitation homework], "#{section_path}.dates", errors) if section['dates']
        require_keys(section, %w[block nav title description episode reading vignette], section_path, errors)
        check_keys(section['episode'], %w[name video description links empty], "#{section_path}.episode", errors)
        require_keys(section['episode'], %w[description], "#{section_path}.episode", errors)
        check_links(section.dig('episode', 'links'), "#{section_path}.episode.links", errors)
        check_keys(section['reading'], %w[chapter name topic description video file links empty], "#{section_path}.reading", errors)
        if section['reading'].is_a?(Hash) && !section['reading'].key?('chapter') && !section['reading'].key?('name')
          errors << "#{section_path}.reading: provide chapter or name"
        end
        check_links(section.dig('reading', 'links'), "#{section_path}.reading.links", errors)
        check_keys(section['vignette'], %w[name description video files solutions solution_file empty], "#{section_path}.vignette", errors)
        require_keys(section['vignette'], %w[description], "#{section_path}.vignette", errors)
        check_keys(section['homework'], %w[due file solutions solution_file practice video], "#{section_path}.homework", errors) if section['homework']
        Array(section['extras']).each_with_index do |extra, extra_index|
          check_keys(extra, %w[name video description links files], "#{section_path}.extras[#{extra_index}]", errors)
          require_keys(extra, %w[name], "#{section_path}.extras[#{extra_index}]", errors)
        end
      elsif section['carousel']
        check_keys(section, %w[carousel], section_path, errors)
        config = section['carousel']
        check_keys(config, %w[id title nav description resources], "#{section_path}.carousel", errors)
        require_keys(config, %w[id title resources], "#{section_path}.carousel", errors)
        Array(config['resources']).each_with_index { |resource, resource_index| check_resource(resource, "#{section_path}.carousel.resources[#{resource_index}]", errors) } if config.is_a?(Hash)
      elsif section['checkpoint']
        check_keys(section, %w[checkpoint], section_path, errors)
        config = section['checkpoint']
        check_keys(config, %w[date when description demo reattempt], "#{section_path}.checkpoint", errors)
        require_keys(config, %w[description demo], "#{section_path}.checkpoint", errors)
        check_keys(config['demo'], %w[video description file], "#{section_path}.checkpoint.demo", errors) if config.is_a?(Hash)
      elsif section['homework_notes']
        check_keys(section, %w[homework_notes], section_path, errors)
        check_keys(section['homework_notes'], %w[id title nav name due file questions], "#{section_path}.homework_notes", errors)
        require_keys(section['homework_notes'], %w[title name due file questions], "#{section_path}.homework_notes", errors)
      elsif section['standalone']
        check_keys(section, %w[standalone], section_path, errors)
        config = section['standalone']
        check_keys(config, %w[id title nav description resource], "#{section_path}.standalone", errors)
        require_keys(config, %w[id title description resource], "#{section_path}.standalone", errors)
        check_resource(config['resource'], "#{section_path}.standalone.resource", errors) if config.is_a?(Hash)
      else
        errors << "#{section_path}: unknown section type"
      end
    end
  end
  errors
end

def validate_video_ids!(parts)
  errors = []
  walk = lambda do |value, path|
    case value
    when Hash
      value.each do |key, child|
        if key == 'video' && child && child !~ /\A[A-Za-z0-9_-]{11}\z/
          errors << "#{path}: invalid YouTube video ID #{child}"
        else
          walk.call(child, "#{path}.#{key}")
        end
      end
    when Array
      value.each_with_index { |child, index| walk.call(child, "#{path}[#{index}]") }
    end
  end
  walk.call(parts, 'parts')
  errors
end

def validate_outputs(outputs)
  errors = []
  warnings = []
  outputs.each do |filename, html|
    ids = html.scan(/\sid="([^"]+)"/).flatten
    id_counts = ids.each_with_object(Hash.new(0)) { |id, counts| counts[id] += 1 }
    id_counts.each { |id, count| errors << "#{filename}: duplicate id #{id}" if count > 1 }
    html.scan(/\bhref="([^"]+)"/).flatten.each do |href|
      next if href.empty? || href.match?(%r{\A(?:[a-z]+:|#|//)}i)

      decoded = CGI.unescape(href.split(/[?#]/, 2).first)
      resolved = ROOT.join(decoded).cleanpath
      unless resolved.to_s.start_with?(ROOT.to_s + File::SEPARATOR)
        errors << "#{filename}: local link escapes project: #{href}"
        next
      end
      next if resolved.exist?

      if KNOWN_MISSING.include?(decoded)
        warnings << "#{filename}: known missing file #{decoded}"
      else
        errors << "#{filename}: missing local file #{decoded}"
      end
    end
  end
  [errors.uniq, warnings.uniq]
end

begin
  data = YAML.safe_load(CONTENT_PATH.read, permitted_classes: [], permitted_symbols: [], aliases: false)
rescue Psych::Exception => error
  warn "Error: invalid YAML in #{CONTENT_PATH.basename}: #{error.message}"
  exit 1
end

parts = data.fetch('parts')
part_ids = parts.keys
errors = validate_schema(parts)
errors.concat(validate_video_ids!(parts))
errors << 'At least one part is required.' if part_ids.empty?
errors.concat(part_ids.reject { |id| id.match?(/\A[A-Z]\z/) }.map { |id| "Invalid part ID: #{id}" })

unless errors.empty?
  errors.uniq.each { |error| warn "Error: #{error}" }
  exit 1
end

outputs = {}
parts.each { |part_id, part| outputs["part-#{part_id.downcase}.html"] = render_part(part_id, part, part_ids) }
outputs['index.html'] = render_index(part_ids.first) unless part_ids.empty?
output_errors, warnings = validate_outputs(outputs)
errors.concat(output_errors)

warnings.each { |warning| warn "Warning: #{warning}" }
unless errors.empty?
  errors.uniq.each { |error| warn "Error: #{error}" }
  exit 1
end

stale = false
outputs.each do |filename, contents|
  path = ROOT.join(filename)
  if CHECK_ONLY
    if !path.exist? || path.read != contents
      stale = true
      warn "Generated file is stale: #{filename}"
    end
  else
    path.write(contents)
    puts "Generated #{filename}"
  end
end

exit 1 if stale
puts 'Generated pages are up to date.' if CHECK_ONLY
