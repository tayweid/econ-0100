#!/usr/bin/env ruby

# Everything committed to econ-0100 is published. Material that should not be
# published belongs in ECON_0100 instead: the repository a file is in IS the
# policy, and this script does not try to second-guess it by inspecting names.
#
# All it still refuses are the things that are never course material and never
# recoverable once pushed -- credentials and per-student records.

require 'open3'
require 'pathname'

ROOT = Pathname.new(__dir__).parent.expand_path

def capture_nul(*command)
  output, status = Open3.capture2(*command, chdir: ROOT.to_s)
  abort "command failed: #{command.join(' ')}" unless status.success?
  output.split("\0").reject(&:empty?)
end

if ARGV.empty?
  label = 'staged additions or changes'
  paths = capture_nul('git', 'diff', '--cached', '--diff-filter=ACMRT', '--name-only', '-z')
elsif ARGV.length == 2 && ARGV.first == '--range'
  base = ARGV.fetch(1)
  system('git', 'rev-parse', '--verify', "#{base}^{commit}", out: File::NULL, err: File::NULL, chdir: ROOT.to_s) ||
    abort("unknown base commit: #{base}")
  label = "additions or changes since #{base}"
  paths = capture_nul('git', 'diff', '--diff-filter=ACMRT', '--name-only', '-z', base, 'HEAD')
else
  abort 'usage: scripts/check-public-boundary [--range BASE_COMMIT]'
end

if paths.empty?
  puts "public boundary: no #{label}"
  exit 0
end

never_publish = lambda do |file_path|
  name = file_path.tr('\\', '/').downcase
  base = File.basename(name)

  base == '.env' ||
    (base.start_with?('.env.') && base != '.env.example') ||
    %w[.pem .key].include?(File.extname(name)) ||
    base.match?(/\A(?:roster|student[-_ ]?records?|grades?)[-_.]/)
end

errors = paths.uniq.sort.select { |file_path| never_publish.call(file_path) }
                        .map { |file_path| "credential or student record: #{file_path}" }

unless errors.empty?
  warn 'public boundary check failed:'
  errors.each { |error| warn "  - #{error}" }
  warn ''
  warn 'These never belong in a public repository. Move them to ECON_0100.'
  exit 1
end

puts "public boundary: #{paths.uniq.length} #{label} passed"
