#!/usr/bin/env ruby

# Validates course-content.yaml.js and the part-*.html shells that render it.
#
# Nothing is generated any more: each part page reads the YAML in the browser. This
# check exists so that a typo in the YAML, a link to a file that is not there, or a page
# shell that no longer matches its part is caught before a commit rather than by a
# student. It mirrors the checks yaml-course-page.js makes at load time, and adds the
# ones only a filesystem can make. Exit status 1 on any error.
#
#   scripts/check-course

require 'pathname'
require 'set'
require 'yaml'

ROOT = Pathname.new(__dir__).parent.expand_path
CONTENT_PATH = ROOT.join('course-content.yaml.js')

# The YAML sits inside a JavaScript wrapper -- window.COURSE_CONTENT_YAML = String.raw`...`; --
# so that a page opened by double-clicking can read it through a <script> tag. Peel the
# wrapper off here. A backtick or a ${ inside the YAML would end or interpolate the JS
# string, so both are refused rather than silently corrupting the site.
def read_content_yaml
  text = CONTENT_PATH.read(encoding: Encoding::UTF_8)
  match = text.match(/^window\.COURSE_CONTENT_YAML = String\.raw`\n(.*)\n`;\n\z/m)
  abort "Error: #{CONTENT_PATH.basename} must end with the YAML wrapped as window.COURSE_CONTENT_YAML = String.raw`...`;" unless match
  yaml = match[1]
  abort "Error: #{CONTENT_PATH.basename} contains a backtick inside the YAML" if yaml.include?('`')
  abort "Error: #{CONTENT_PATH.basename} contains ${ inside the YAML" if yaml.include?('${')
  yaml
end

# The block's directory under Parts/<PART>/, found by its ID prefix. nil when there is
# no unique match.
def block_dir(block_id)
  $block_dirs ||= {}
  return $block_dirs[block_id] if $block_dirs.key?(block_id)

  part = block_id[0]
  matches = Dir.glob(ROOT.join('Parts', part, "#{block_id}_*").to_s)
                .select { |path| File.directory?(path) }
                .map { |path| Pathname.new(path).relative_path_from(ROOT).to_s }
                .sort
  $block_dirs[block_id] = matches.length == 1 ? matches.first : nil
end

def check_keys(value, allowed, path, errors)
  unless value.is_a?(Hash)
    errors << "#{path} must be a mapping"
    return
  end
  (value.keys - allowed).each { |key| errors << "#{path}: unknown field #{key}" }
end

def require_keys(value, required, path, errors)
  return unless value.is_a?(Hash)

  required.each { |key| errors << "#{path}: missing required field #{key}" unless value.key?(key) }
end

def check_links(value, path, errors)
  Array(value).each_with_index do |item, index|
    check_keys(item, %w[label file optional icon], "#{path}[#{index}]", errors)
    require_keys(item, %w[label file], "#{path}[#{index}]", errors)
  end
end

def check_extras(value, path, errors)
  Array(value).each_with_index do |extra, index|
    check_keys(extra, %w[name video description links files], "#{path}[#{index}]", errors)
    require_keys(extra, %w[name], "#{path}[#{index}]", errors)
    check_links(extra['links'], "#{path}[#{index}].links", errors)
  end
end

def validate_schema(parts)
  errors = []
  return ['parts must be a mapping'] unless parts.is_a?(Hash)

  parts.each do |part_id, part|
    path = "parts.#{part_id}"
    check_keys(part, %w[title tagline introduction homework_defaults sections links], path, errors)
    require_keys(part, %w[title tagline introduction sections], path, errors)
    next unless part.is_a?(Hash)

    check_links(part['links'], "#{path}.links", errors)
    check_keys(part['homework_defaults'], %w[due file solutions solution_file practice], "#{path}.homework_defaults", errors) if part['homework_defaults']
    unless part['sections'].is_a?(Array)
      errors << "#{path}.sections must be a list"
      next
    end

    part['sections'].each_with_index do |section, index|
      section_path = "#{path}.sections[#{index}]"
      unless section.is_a?(Hash)
        errors << "#{section_path} must be a mapping"
        next
      end

      if section['block']
        check_keys(section, %w[block folder nav title description episode reading vignette homework extras exercise dates practice steps], section_path, errors)
        require_keys(section, %w[block nav title description episode reading], section_path, errors)
        require_keys(section, %w[vignette], section_path, errors) unless section['practice'] == false || section['steps']
        Array(section['steps']).each_with_index do |step, step_index|
          check_keys(step, %w[name where links date due video], "#{section_path}.steps[#{step_index}]", errors)
          require_keys(step, %w[name], "#{section_path}.steps[#{step_index}]", errors)
          check_links(step['links'], "#{section_path}.steps[#{step_index}].links", errors)
        end
        check_keys(section['exercise'], %w[name links video], "#{section_path}.exercise", errors) if section['exercise']
        # folder: is how the page reaches the block's conventional PDFs. It is required as
        # soon as the block has a directory on disk; a block with no material yet may omit it.
        globbed = block_dir(section['block'])
        if section['folder']
          declared = "Parts/#{section['block'][0]}/#{section['folder']}"
          if !ROOT.join(declared).directory?
            errors << "#{section_path}.folder: no such directory #{declared}"
          elsif globbed && globbed != declared
            errors << "#{section_path}.folder: #{declared} does not match the block folder #{globbed}"
          end
        elsif globbed
          errors << "#{section_path}: missing folder (#{globbed} exists, so the page cannot find its PDFs without it)"
        end
        check_keys(section['dates'], %w[class recitation homework], "#{section_path}.dates", errors) if section['dates']
        check_keys(section['episode'], %w[name video description links empty], "#{section_path}.episode", errors)
        require_keys(section['episode'], %w[description], "#{section_path}.episode", errors)
        check_links(section.dig('episode', 'links'), "#{section_path}.episode.links", errors)
        check_keys(section['reading'], %w[chapter name topic description video file links empty], "#{section_path}.reading", errors)
        if section['reading'].is_a?(Hash) && !section['reading'].key?('chapter') && !section['reading'].key?('name')
          errors << "#{section_path}.reading: provide chapter or name"
        end
        check_links(section.dig('reading', 'links'), "#{section_path}.reading.links", errors)
        if section['practice'] != false && !section['steps']
          check_keys(section['vignette'], %w[name description video links files solutions solution_file empty], "#{section_path}.vignette", errors)
          require_keys(section['vignette'], %w[description], "#{section_path}.vignette", errors)
          check_links(section.dig('vignette', 'links'), "#{section_path}.vignette.links", errors)
        end
        check_keys(section['homework'], %w[due file links solutions solution_file practice video], "#{section_path}.homework", errors) if section['homework']
        check_extras(section['extras'], "#{section_path}.extras", errors)
      elsif section['checkpoint']
        check_keys(section, %w[checkpoint], section_path, errors)
        config = section['checkpoint']
        check_keys(config, %w[date when description demo reattempt extras], "#{section_path}.checkpoint", errors)
        require_keys(config, %w[description demo], "#{section_path}.checkpoint", errors)
        if config.is_a?(Hash)
          check_keys(config['demo'], %w[video description file links], "#{section_path}.checkpoint.demo", errors)
          check_links(config.dig('demo', 'links'), "#{section_path}.checkpoint.demo.links", errors)
          check_extras(config['extras'], "#{section_path}.checkpoint.extras", errors)
        end
      else
        errors << "#{section_path}: unknown section type (the pages render block and checkpoint sections)"
      end
    end
  end
  errors
end

def validate_video_ids(parts)
  errors = []
  walk = lambda do |value, path|
    case value
    when Hash
      value.each do |key, child|
        if key == 'video' && child && child !~ /\A[A-Za-z0-9_-]{11}\z/
          errors << "#{path}: invalid YouTube video ID #{child}"
        else
          walk.call(child, "#{path}.#{key}")
        end
      end
    when Array
      value.each_with_index { |child, index| walk.call(child, "#{path}[#{index}]") }
    end
  end
  walk.call(parts, 'parts')
  errors
end

# Every local path the YAML names outright must exist, or the page renders a chip that
# 404s. Bare names such as `file: A1` are conventional bases the page resolves and
# existence-checks itself, and are skipped here; so are http(s) links, and a
# solution_file that is switched off (the page renders it only under solutions: true).
def local_path?(value)
  value.is_a?(String) && value.include?('/') && !value.match?(%r{\A(?:[a-z]+:|//)}i)
end

def local_exists?(value)
  ROOT.join(value.split(/[?#]/, 2).first).exist?
end

def validate_files(parts)
  errors = []
  walk = lambda do |value, path|
    case value
    when Hash
      value.each do |key, child|
        if key == 'solution_file' && value['solutions'] != true
          next
        elsif %w[file solution_file].include?(key) && local_path?(child)
          errors << "#{path}.#{key}: missing local file #{child}" unless local_exists?(child)
        elsif key == 'chapter' && child && !value.key?('file')
          file = "Reading/Ch_#{child.to_s.rjust(2, '0')}.pdf"
          errors << "#{path}.#{key}: missing #{file}" unless local_exists?(file)
        else
          walk.call(child, "#{path}.#{key}")
        end
      end
    when Array
      value.each_with_index { |child, index| walk.call(child, "#{path}[#{index}]") }
    end
  end
  walk.call(parts, 'parts')
  errors
end

# The HTML shell of each part must match its YAML the way yaml-course-page.js demands at
# load time: one slot per block in order, ids of the form part-<block>, a checkpoint slot
# exactly when the YAML has a checkpoint, and a right-hand navigation to match. The
# left-hand navigation must reach every part.
def validate_shell(part_id, part, part_ids)
  filename = "part-#{part_id.downcase}.html"
  page = ROOT.join(filename)
  return ["#{filename}: missing page for part #{part_id}"] unless page.exist?

  html = page.read(encoding: Encoding::UTF_8)
  errors = []
  errors << "#{filename}: data-course-part is not #{part_id}" unless html.include?(%(data-course-part="#{part_id}"))

  sections = Array(part['sections']).select { |section| section.is_a?(Hash) }
  block_ids = sections.map { |section| section['block'] }.compact
  expected_ids = block_ids.map { |block_id| "part-#{block_id.downcase}" }

  slots = html.scan(/<div class="block" id="([^"]+)" data-course-block="([^"]+)">/)
  if slots.map(&:last) != block_ids
    errors << "#{filename}: block shells (#{slots.map(&:last).join(', ')}) do not match the YAML (#{block_ids.join(', ')})"
  elsif slots.map(&:first) != expected_ids
    errors << "#{filename}: block ids (#{slots.map(&:first).join(', ')}) should be #{expected_ids.join(', ')}"
  end

  has_checkpoint = sections.any? { |section| section['checkpoint'] }
  checkpoint_slot = html.match(/<div class="block checkpoint" id="([^"]+)" data-course-checkpoint>/)
  if has_checkpoint && !checkpoint_slot
    errors << "#{filename}: the YAML has a checkpoint but the page has no checkpoint shell"
  elsif !has_checkpoint && checkpoint_slot
    errors << "#{filename}: the page has a checkpoint shell but the YAML has no checkpoint"
  elsif checkpoint_slot && checkpoint_slot[1] != 'checkpoint'
    errors << "#{filename}: the checkpoint shell id should be checkpoint"
  end

  navigation = html.scan(/<a href="([^"]+)" class="nav-link-right[^"]*"(?: data-nav-block="([^"]+)")?>/)
  expected = block_ids.each_with_index.map { |block_id, index| ["##{expected_ids[index]}", block_id] }
  expected << ['#checkpoint', nil] if has_checkpoint
  errors << "#{filename}: the right-hand navigation does not match the YAML" unless navigation == expected

  part_ids.each do |other|
    errors << "#{filename}: left-hand navigation does not link to part-#{other.downcase}.html" unless html.include?(%(href="part-#{other.downcase}.html"))
  end
  unless html.include?(%(class="active" aria-current="page" href="#{filename}"))
    errors << "#{filename}: left-hand navigation does not mark #{filename} as the current page"
  end
  errors
end

begin
  data = YAML.safe_load(read_content_yaml, permitted_classes: [], permitted_symbols: [], aliases: false)
rescue Psych::Exception => error
  warn "Error: invalid YAML in #{CONTENT_PATH.basename}: #{error.message}"
  exit 1
end

parts = data.is_a?(Hash) ? data['parts'] : nil
abort "Error: #{CONTENT_PATH.basename} has no parts: mapping" unless parts.is_a?(Hash)

part_ids = parts.keys
errors = validate_schema(parts)
errors.concat(validate_video_ids(parts))
errors.concat(validate_files(parts))
errors << 'At least one part is required.' if part_ids.empty?
errors.concat(part_ids.reject { |id| id.to_s.match?(/\A[A-Z]\z/) }.map { |id| "Invalid part ID: #{id}" })

all_blocks = parts.values.flat_map { |part| Array(part['sections']).map { |section| section.is_a?(Hash) ? section['block'] : nil } }.compact
all_blocks.each_with_object(Hash.new(0)) { |id, counts| counts[id] += 1 }
          .select { |_id, count| count > 1 }
          .each_key { |id| errors << "Duplicate block ID: #{id}" }

parts.each { |part_id, part| errors.concat(validate_shell(part_id.to_s, part, part_ids)) if part.is_a?(Hash) }

unless errors.empty?
  errors.uniq.each { |error| warn "Error: #{error}" }
  exit 1
end

puts "#{CONTENT_PATH.basename} and #{part_ids.map { |id| "part-#{id.downcase}.html" }.join(', ')} are consistent."
