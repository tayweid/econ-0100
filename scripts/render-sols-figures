#!/usr/bin/env python3
"""Re-render the graphs in the solution guides.

Each solution guide (Part_<X>/<block>/<kind>/<Name>_sols.md, Recitations/
Week_N_sols.md, or an older _sols.typ) is one self-contained Plass file. Its graphs are embedded as
base64 SVG data URLs in #image(...) calls, and the Typst that draws them sits
at the end of the same file inside a Plass comment frame (// plass:comment ... in a .typ,
an HTML comment <!-- ... --> in a .md; a .md embeds its graphs as ![alt](data:...) images;
any .md given on the command line works, not only guides)
// /plass:comment), which Plass shows as a note in the editor and leaves out of
the PDF. The frame imports _Assets/sols.typ and draws one graph per
page, in the order the #image calls appear. This script compiles each guide's
frame and replaces the n-th #image with the n-th page. Needs the typst CLI
(brew install typst). Run it after editing a frame:

    scripts/render-sols-figures                  # every guide
    scripts/render-sols-figures path/to/X_sols.md
"""
import base64, re, subprocess, sys, tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
HELPERS = '#import "/_Assets/sols.typ"'
IMAGE = re.compile(r'#image\("[^"]*"')
# Plass Markdown: a plain image whose source is an SVG data URL (empty until rendered).
MD_IMAGE = re.compile(r'!\[([^\]]*)\]\(data:image/svg\+xml;base64,[^)]*\)')


def figure_frame(text):
    """The payload of the comment frame that imports the figure helpers."""
    for m in re.finditer(r'<!--\n(.*?)\n-->', text, re.S):  # Plass Markdown comment
        if HELPERS in m.group(1):
            return m.group(1)
    for m in re.finditer(r'^// plass:comment\n(.*?)^// /plass:comment$', text, re.S | re.M):
        payload = '\n'.join(re.sub(r'^// \|( |$)', '', line) for line in m.group(1).splitlines())
        if HELPERS in payload:
            return payload
    return None


def render(guide):
    text = guide.read_text()
    image = MD_IMAGE if guide.suffix == '.md' else IMAGE
    slots = image.findall(text)
    frame = figure_frame(text)
    if frame is None:
        if slots:
            sys.exit(f'{guide}: has {len(slots)} #image slot(s) but no figure frame')
        return
    src = guide.with_name('.' + guide.stem + '_figures.typ')  # inside --root
    with tempfile.TemporaryDirectory() as out:
        try:
            src.write_text(frame + '\n')
            subprocess.run(['typst', 'compile', '--root', ROOT, '-f', 'svg', src, f'{out}/{{p}}.svg'], check=True)
        finally:
            src.unlink(missing_ok=True)
        pages = sorted(Path(out).glob('*.svg'), key=lambda p: int(p.stem))
        if len(pages) != len(slots):
            sys.exit(f'{guide}: {len(slots)} #image slot(s) but {len(pages)} rendered page(s)')
        data = iter([base64.b64encode(p.read_bytes()).decode() for p in pages])
    if guide.suffix == '.md':
        new = image.sub(lambda m: f'![{m.group(1)}](data:image/svg+xml;base64,{next(data)})', text)
    else:
        new = image.sub(lambda m: f'#image("data:image/svg+xml;base64,{next(data)}"', text)
    if new != text:
        guide.write_text(new)
    print(f'{guide.relative_to(ROOT)}: {len(pages)} figure(s){"" if new != text else " (unchanged)"}')


guides = [Path(a).resolve() for a in sys.argv[1:]] or sorted(
    g for g in [*ROOT.glob('Part_[A-F]/*/*/*_sols.typ'), *ROOT.glob('Part_[A-F]/*/*/*_sols.md'),
                *ROOT.glob('Recitations/*_sols.typ'), *ROOT.glob('Recitations/*_sols.md')]
    if '_archive' not in g.parts)  # an archived guide stays as it was
for g in guides:
    render(g)
